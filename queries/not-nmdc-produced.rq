# Which "NMDC-labelled" datasets are NOT produced by NMDC?
# The name never tells you. The tag and the provenance link do.
PREFIX schema: <http://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?name ?tag ?derivedFrom WHERE {
  ?d a schema:Dataset ;
     schema:name ?name ;
     schema:keywords ?tag .
  OPTIONAL { ?d prov:wasDerivedFrom ?derivedFrom }
}
ORDER BY ?tag ?name
