# Who produced each resource, and what was it derived from?
# The database name gives you the host tenant. It does not give you the producer.
# This query reads the producer off the graph instead.
PREFIX schema: <http://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?name ?producer ?derivedFrom WHERE {
  ?d a schema:Dataset ;
     schema:name ?name ;
     schema:keywords ?producer .
  OPTIONAL { ?d prov:wasDerivedFrom ?derivedFrom }
}
ORDER BY ?name
