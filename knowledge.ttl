    schema1:creativeWorkStatus "draft" ;
    schema1:dateModified "2026-08-26T00:00:00+00:00"^^xsd:dateTime ;
    schema1:description "Omics records originating with NMDC, which the Arkin Lab at LBNL has extended with vector embeddings, organism trait assignments, and a reconciled annotation layer." ;
    schema1:keywords "derived" ;
